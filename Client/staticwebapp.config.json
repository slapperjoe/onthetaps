{
   "navigationFallback": {
      "rewrite": "/index.html"
   },
   "routes": [
      {
         "route": "/api/*",
         "methods": [ "PUT", "POST", "PATCH", "DELETE" ],
         "allowedRoles": [ "tochka" ]
      }
   ],
   "mimeTypes": {
      ".json": "text/json"
   },
   "auth": {
      "identityProviders": {
         "facebook": {
            "registration": {
               "appIdSettingName": "FACEBOOK_APP_ID",
               "appSecretSettingName": "FACEBOOK_APP_SECRET"
            }
         }
      }
   }
}