@page "/"
@namespace Client.Pages

<PageTitle>Tochka</PageTitle>

@using BigBeerData.Shared
@using BigBeerData.Shared.DTOs
@using System.Net.Http
@using System.Threading
@using System.Web
@using System.Net.Http.Headers
@using System.Text.Json
@using MudBlazor
@using System.Text;

@using OnTheTaps.Client.Types;
@using Types;
@using OnTheTaps.Client.Components;

@inject HttpClient Http
@inject OnTheTaps.Client.Services.BrowserService Browser
@inject ILogger<Index> Logger

@inject IJSRuntime JSRuntime

@inject AuthenticationStateProvider AuthenticationStateProvider

<style>
	.fluid {
				width: 100%;
				height: auto;
	}

	.tapLoadBox {
				width: 100%;
				height: 100%;
				background-color: rgba(0,0,0, 0.5);
				position: absolute;
				top: 0px;
				border-radius: 5px;
	}

	.mud-slider {
				margin-top: -8px;
	}

				.mud-slider .mud-slider-container {
							padding-left: 24px;
							padding-right: 24px;
				}
</style>




	<MudGrid>
		@for (int i = 0; i < TAP_COUNT; i++)
		{
			try
			{
				if (costList.Count() > i)
				{
					int localIndex = i + 1;
					<AuthorizeView>
						<Authorized>
							<EditableTap beer="costList[localIndex-1]"
							  tapNumber="@localIndex"
							  canEdit="@context.User.IsInRole("tochka")"
							  beerUpdate="@((upd) => updateChanged(upd as BeerDTO))"
							  updateData="(i) => UpdateData((int)i)"
							  updateImage="@((f) => UploadFiles(f as FileItemDTO))" />
						</Authorized>
						<NotAuthorized>
							<ReadonlyTap beer="costList[localIndex-1]"
								tapNumber="@localIndex" />							
						</NotAuthorized>
					</AuthorizeView>
				}
			}
			catch (Exception)
			{
				var f = i;
				var bob = costList;
			}
		}

	</MudGrid>

@code {

	[Inject] private IDialogService DialogService { get; set; } = default!;

	const int TAP_COUNT = 6;

	ElementReference[] imageRef { get; set; } = new ElementReference[TAP_COUNT];
	List<BeerDTO> costList = new List<BeerDTO>();
	IDictionary<int, IBrowserFile> filesD = new Dictionary<int, IBrowserFile>();

	List<File> files = new List<File>();
	List<UploadResult> uploadResults = new List<UploadResult>();
	bool upload = false;

	bool readyForUpdate = false;

	protected override async Task OnInitializedAsync()
	{
		for (int i = 0; i < TAP_COUNT; i++)
		{
			try
			{
				var result = await Http.GetFromJsonAsync<BeerDTO>(Browser.TapJson(i+1));
				costList.Add(result ?? new BeerDTO());
			}
			catch (Exception e)
			{
				Logger.LogError(e.Message);
				costList.Add(new BeerDTO());
			}
		}
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (!firstRender)
		{
			readyForUpdate = true;
		}
		base.OnAfterRender(firstRender);
	}

	protected void updateChanged(BeerDTO beerDTO)
	{
		if (readyForUpdate)
		{
			beerDTO.changed = true;
		}
	}

	private async void UpdateData(int i)
	{
		var loadBox = imageRef[i - 1];
		await Browser.ShowLoadBox(loadBox);

		var toUpdate = costList[i - 1];
		toUpdate.changed = false;
		var js = JsonSerializer.Serialize(toUpdate);

		var response =
			await Http.PostAsync("api/DataUpload", new StringContent(JsonSerializer.Serialize(toUpdate), Encoding.UTF8, "application/json"));

		await CheckResponse(response);

		await Browser.HideLoadBox(loadBox);

		StateHasChanged();
	}

	private async Task<bool?> CheckResponse(HttpResponseMessage response)
	{
		if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
		{
			var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small };
			return await DialogService.ShowMessageBox("Unauthorised", "You must be logged in to perform this action", options: options);
		}
		return null;
	}

	private async void UploadFiles(FileItemDTO fDTO)
	{
		var fileName = fDTO.file.File.Name;
		fileName = fDTO.tapNumber + fileName.Substring(fDTO.file.File.Name.LastIndexOf('.'));

		var maxFileSize = 10240000;

		var loadBox = fDTO.loadBox;

		await Browser.ShowLoadBox(loadBox);

		using var content = new MultipartFormDataContent();

		try
		{
			var fileContent = new StreamContent(fDTO.file.File.OpenReadStream(maxFileSize));

			fileContent.Headers.ContentType = new MediaTypeHeaderValue(fDTO.file.File.ContentType);

			files.Add(new() { Name = fileName });

			content.Add(
					content: fileContent,
					name: "\"files\"",
					fileName: fileName);

			upload = true;
		}
		catch (Exception ex)
		{
			Logger.LogInformation(
					"{FileName} not uploaded (Err: 6): {Message}",
					fileName, ex.Message);

			uploadResults.Add(new()
				{
					FileName = fileName,
					ErrorCode = 6,
					Uploaded = false
				});
		}
		if (upload)
		{
			var response = await Http.PostAsync("api/FileUpload", content);

			if (response.IsSuccessStatusCode)
			{
				//Browser.RefreshImage(fileName);
				await Browser.HideLoadBox(loadBox);
				StateHasChanged();
			}
		}
	}
}