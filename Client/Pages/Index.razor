@page "/"
@namespace Client.Pages

<PageTitle>Tochka</PageTitle>

@using BigBeerData.Shared
@using BigBeerData.Shared.DTOs
@using System.Net.Http
@using System.Threading
@using System.Web
@using System.Net.Http.Headers
@using System.Text.Json
@using MudBlazor
@using System.Text;

@using OnTheTaps.Client.Types;
@using Types;
@using OnTheTaps.Client.Components;

@inject HttpClient Http
@inject OnTheTaps.Client.Services.BrowserService Browser
@inject ILogger<Index> Logger

@inject IJSRuntime JSRuntime

@inject AuthenticationStateProvider AuthenticationStateProvider

<style>
	.fluid {
				width: 100%;
				height: auto;
	}

	.tapLoadBox {
				width: 100%;
				height: 100%;
				background-color: rgba(0,0,0, 0.5);
				position: absolute;
				top: 0px;
				border-radius: 5px;
	}

	.mud-slider {
				margin-top: -8px;
	}

				.mud-slider .mud-slider-container {
							padding-left: 24px;
							padding-right: 24px;
				}
</style>




<MudGrid>
	@foreach (var tap in costList)
	{
		try
		{
			<AuthorizeView>
				<Authorized>
					<EditableTap beer="tap"
					  tapNumber="@tap.tapNo"
					  canEdit="@context.User.IsInRole("tochka")"
					  beerUpdate="@((upd) => updateChanged(upd as BeerDTO))"
					  updateData="@((b) => UpdateData(b as BeerItemDTO))"
					  updateImage="@((f) => UploadFiles(f as FileItemDTO))" />
				</Authorized>
				<NotAuthorized>
					<ReadonlyTap beer="tap"
				  tapNumber="@tap.tapNo" />
				</NotAuthorized>
			</AuthorizeView>

		}
		catch (Exception e)
		{
			Logger.LogError(e.Message);
		}
	}

</MudGrid>

@code {

	[Inject] private IDialogService DialogService { get; set; } = default!;

	const int TAP_COUNT = 6;

	ElementReference[] imageRef { get; set; } = new ElementReference[TAP_COUNT];
	List<BeerDTO> costList = new List<BeerDTO>();
	IDictionary<int, IBrowserFile> filesD = new Dictionary<int, IBrowserFile>();

	bool readyForUpdate = false;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			costList = await Http.GetFromJsonAsync<List<BeerDTO>>("api/Taplist");
		}
		catch (Exception e)
		{
			Logger.LogError(e.Message);
			costList = new List<BeerDTO>();
		}
	}

	protected override void OnAfterRender(bool firstRender)
	{
		if (!firstRender)
		{
			readyForUpdate = true;
		}
		base.OnAfterRender(firstRender);
	}

	protected void updateChanged(BeerDTO beerDTO)
	{
		if (readyForUpdate)
		{
			beerDTO.changed = true;
		}
	}

	private async void UpdateData(BeerItemDTO bDTO)//int i)
	{
		await Browser.ShowLoadBox(bDTO.loadBox);

		var toUpdate = bDTO.beer;
		var response = await Http.PostAsync("api/DataUpload", new StringContent(JsonSerializer.Serialize(toUpdate), Encoding.UTF8, "application/json"));

		await CheckResponse(response);
		toUpdate.changed = false;

		await Browser.HideLoadBox(bDTO.loadBox);
		StateHasChanged();
	}

	private async Task<bool?> CheckResponse(HttpResponseMessage response)
	{
		if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
		{
			var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small };
			return await DialogService.ShowMessageBox("Unauthorised", "You must be logged in to perform this action", options: options);
		}
		return null;
	}

	private async void UploadFiles(FileItemDTO fDTO)
	{
		await Browser.ShowLoadBox(fDTO.loadBox);
		using var content = new MultipartFormDataContent();
		try
		{
			content.Add(fDTO.GetFileStream(), "\"files\"", fDTO.fileName);
			var response = await Http.PostAsync("api/FileUpload", content);
			if (response.IsSuccessStatusCode)
			{
				await Browser.HideLoadBox(fDTO.loadBox);
			}
		}
		catch (Exception ex)
		{
			Logger.LogInformation("{FileName} not uploaded (Err: 6): {Message}", fDTO.fileName, ex.Message);
		}
		StateHasChanged();
	}
}