@page "/Login"
@namespace Client.Pages

@inject NavigationManager NavManager

<PageTitle>Login</PageTitle>

@using System.Net.Http
@using System.Threading
@using System.Web
@using System.Net.Http.Headers
@using System.Text.Json
@using MudBlazor
@using System.Text;

<MudText Typo="Typo.h4" Class="login-title">Pick login provider</MudText>
<MudGrid Justify="Justify.SpaceAround">
	<MudItem xs="12" md="6" lg="4">
		<MudFab Label="Microsoft" Icon="@Icons.Custom.Brands.Microsoft" Color="Color.Surface" OnClick='() => DoLogin("aad")'/>
	</MudItem>
	<MudItem xs="12" md="6" lg="4">
		<MudFab Label="Twitter" Icon="@Icons.Custom.Brands.Twitter" Color="Color.Surface" OnClick='() => DoLogin("twitter")' />
	</MudItem>
	<MudItem xs="12" md="6" lg="4">
		<MudFab Label="Google" Icon="@Icons.Custom.Brands.Google" Color="Color.Surface" OnClick='() => DoLogin("google")' />
	</MudItem>
@*	<MudItem xs="12" md="6" lg="4">
		<MudFab Label="Facebook" Icon="@Icons.Custom.Brands.Facebook" Color="Color.Surface" OnClick='() => DoLogin("facebook")' />
	</MudItem>*@

</MudGrid>

@code {

	private void DoLogin(string loginType)
	{
		NavManager.NavigateTo($"/.auth/login/{loginType}?post_login_redirect_uri=https://www.onthetaps.com/", true);
	}
}