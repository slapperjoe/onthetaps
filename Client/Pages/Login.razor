@page "/Login"
@namespace Client.Pages

@inject NavigationManager NavManager

<PageTitle>Login</PageTitle>

@using System.Net.Http
@using System.Threading
@using System.Web
@using System.Net.Http.Headers
@using System.Text.Json
@using MudBlazor
@using System.Text;

<MudText Typo="Typo.h4" Class="login-title">Pick login provider</MudText>
<MudStack>
	<MudFab Label="Microsoft" Icon="@Icons.Custom.Brands.Microsoft" OnClick='() => DoLogin("aad")' Class="login-button microsoft" />
	<MudFab Label="Twitter" Icon="@Icons.Custom.Brands.Twitter" OnClick='() => DoLogin("twitter")' Class="login-button twitter" />
	<MudFab Label="Google" Icon="@Icons.Custom.Brands.Google" OnClick='() => DoLogin("google")' Class="login-button google" />
	<MudFab Label="GitHub"  Icon="@Icons.Custom.Brands.GitHub" OnClick='() => DoLogin("github")' Class="login-button github" />
</MudStack>

@code {

	private void DoLogin(string loginType)
	{
		NavManager.NavigateTo($"/.auth/login/{loginType}?post_login_redirect_uri=https://www.onthetaps.com/", true);
	}
}