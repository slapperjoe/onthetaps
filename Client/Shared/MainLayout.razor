@inherits LayoutComponentBase


@using System.Net.Http
@using BigBeerData.Shared

@inject NavigationManager NavManager


<MudThemeProvider Theme="BeerTheme" />

<MudLayout>
	<MudAppBar>
		<img src="/img/onthebeers.png" alt="On The Beers/Big Beer Data" style="max-height: 100%;" />
		<MudSpacer />
		<AuthorizeView>
			<Authorized>
				Hello, @context.User.Identity.Name!
				<MudLink Href="/.auth/logout?post_logout_redirect_uri=/">Logout</MudLink>
			</Authorized>
			<NotAuthorized>
				<MudLink Href="/Login">Login</MudLink>
			</NotAuthorized>
		</AuthorizeView>		
	</MudAppBar>
	<MudMainContent>
		<MudContainer MaxWidth="MaxWidth.False">
				@Body
		</MudContainer>
	</MudMainContent>
</MudLayout>

@code {


	MudTheme BeerTheme = new MudTheme()
		{
			Palette = new Palette()
			{
				Primary = Colors.Yellow.Default,
				Secondary = Colors.Brown.Darken2,
				AppbarBackground = Colors.Shades.White,
				AppbarText = Colors.Brown.Darken3
			},
		};

	}

