@inherits LayoutComponentBase


@using System.Net.Http
@using BigBeerData.Shared

@inject NavigationManager NavManager


<MudThemeProvider Theme="BeerTheme" />
<MudDialogProvider />

<MudLayout>
	<MudAppBar>
		<img src="/img/onthetaps.png" alt="On The Taps" style="max-height: 100%;" />
		<MudSpacer />
		<AuthorizeView>
			<Authorized>
				<MudText Typo="Typo.body1">
					Hello, @(context.User.Identity.Name)&nbsp;
				</MudText>
				<MudLink Href="/.auth/logout?post_logout_redirect_uri=/">Logout</MudLink>
			</Authorized>
			<NotAuthorized>
				<MudSelect T="string" @bind-Value="@venue" label="Tap Venue">
					<MudSelectItem Value="@("Tochka")">Tochka Beer Point</MudSelectItem>
				</MudSelect>
				<MudLink Class="login-link" Href="/Login">Login</MudLink>
			</NotAuthorized>
		</AuthorizeView>
	</MudAppBar>
	<MudMainContent>
		<MudContainer MaxWidth="MaxWidth.False">
			@Body
		</MudContainer>
	</MudMainContent>
</MudLayout>

@code {

	string venue = "Tochka";


	MudTheme BeerTheme = new MudTheme()
		{
			Palette = new Palette()
			{
				Primary = Colors.Yellow.Darken3,
				Secondary = Colors.Brown.Darken2,
				AppbarBackground = Colors.Shades.White,
				AppbarText = Colors.Brown.Darken3,

			},
		};
}

